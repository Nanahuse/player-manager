{
	"name": "player-manager",
	"version": "2.2.0",
	"packageManager": "pnpm@12.9.1",
	"scripts": {
		"start": "nodecg start",
		"build": "pnpm build:protocol && vite build",
		"dev": "pnpm build:protocol && run-p dev:*",
		"dev:tsc": "tsc -b src/browser src/extension -w --preserveWatchOutput",
		"dev:vite": "vite",
		"dev:nodecg": "nodecg start",
		"generate-schema-types": "nodecg schema-types -o ./src/types/generated",
		"clean": "trash node_modules/.cache && trash dashboard && trash extension",
		"typecheck": "pnpm build:protocol && tsc -p src/browser && tsc -p src/extension",
		"format": "biome check --write",
		"dev:format": "biome check --write --unsafe",
		"test": "pnpm build:protocol && node --experimental-transform-types --test test/*.test.ts",
		"build:protocol": "pnpm --filter @nanahuse/player-manager-protocol build"
	},
	"nodecg": {
		"compatibleRange": "^2.5.0",
		"dashboardPanels": [
			{
				"file": "PlayerMapping.html",
				"title": "Player Directory",
				"name": "player-mapping",
				"fullbleed": true
			},
			{
				"file": "Registration.html",
				"title": "Register Player",
				"name": "player-registration",
				"dialog": true
			}
		],
		"graphics": []
	},
	"devDependencies": {
		"@nodecg/types": "^2.8.0",
		"@types/obs-studio": "^2.17.2",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.1",
		"globby": "^14.1.0",
		"happy-dom": "^20.14.5",
		"npm-run-all": "^4.1.5",
		"rollup": "^4.63.1",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-node-externals": "^7.1.3",
		"trash-cli": "^6.0.0",
		"typescript": "^5.9.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.12",
		"@mdi/react": "^1.6.1",
		"@nanahuse/player-manager-protocol": "workspace:*",
		"@nodecg/react-hooks": "^1.0.3",
		"google-auth-library": "^11.1.0",
		"nodecg": "^2.8.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tslib": "^2.8.1"
	},
	"private": true
}
