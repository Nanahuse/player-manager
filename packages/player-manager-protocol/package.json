{
	"name": "@nanahuse/player-manager-protocol",
	"version": "2.0.1",
	"private": true,
	"packageManager": "pnpm@12.9.1",
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node finalize.cjs",
		"prepare": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node finalize.cjs"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"files": ["dist"],
	"devDependencies": {
		"typescript": "^5.9.3"
	}
}
